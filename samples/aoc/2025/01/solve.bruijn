:import std/List .
:import std/Combinator .
:import std/String .
:import std/Math .
:import std/Logic .
:import std/Char C
:import std/Number/Ternary T
:import std/Pair P

parse-rotation [mul abs sign] ⧗ String → Rotation
	abs string→number (tail 0)
	sign C.eq? 'L' (head 0) (-1) (+1)

rotate [[T.mod (1 + 0) (+100)]] ⧗ Position → Rotation → Position

count-zeros (scanl rotate (+50)) → (filter zero?) → length

trunc-div [[(P.fst qe) + tweak]] ⧗ Number → Number → Number
	tweak and? (negative? 1) (not! (zero? re)) (+1) (+0)
		re P.snd (T.quot-rem 1 0)
	qe T.quot-rem 1 0

rotate-counting-zeros [[P.pair new-pos new-count]] ⧗ PositionAndCount → Rotation → PositionAndCount
	new-pos T.mod (T.add (P.fst 1) 0) (+100)
	new-count T.add (T.add (P.snd 1) (T.abs (trunc-div (T.add (P.fst 1) 0) (+100)))) tweak
		tweak and? (T.positive? (P.fst 1)) (not! (positive? (T.add (P.fst 1) 0))) (+1) (+0)

count-zero-passes [P.snd (foldl rotate-counting-zeros (P.pair (+50) (+0)) 0)]

append-with-slash [[append (append 1 "/") 0]]

main trim → lines → (map parse-rotation) → (φ append-with-slash part1 part2)
	part1 (count-zeros → number→string)
	part2 (count-zero-passes → number→string)