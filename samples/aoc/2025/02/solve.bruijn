:import std/List .
:import std/Combinator .
:import std/String S
:import std/String .
:import std/Math .
:import std/Logic .
:import std/Char C
:import std/Number/Ternary T
:import std/Pair P

list-to-pair [P.pair (head 0) (head (tail 0))] ⧗ (List a) → (Pair a)

parse-range (split-list-by (C.eq? '-')) → (map string→number) → list-to-pair ⧗ String → Range

parse-ranges (split-list-by (C.eq? ',')) → (map parse-range) ⧗ String → (List Range)

halve [take (T.div (S.length 0) (+2)) 0] ⧗ String → String

string-equals? [[and? (S.eq? 1 0) (T.eq? (S.length 1) (S.length 0))]] ⧗ String → String → Boolean

is-duplicate [string-equals? 0 (S.append half half)] ⧗ String → Boolean
	half take (T.div (S.length 0) (+2)) 0

is-invalid-id [is-duplicate (number→string 0)] ⧗ Number → Boolean

# 0 end
# 1 start
# 2 make-range
numbers-from-to z [[[rec]]] ⧗ Number → Number → (List Number)
	rec (gt? 1 0) empty (cons 1 (2 (T.inc 1) 0))

numbers-in-range [numbers-from-to (P.fst 0) (P.snd 0)] ⧗ Range → (List Number)

sum-invalid-in-range [sum (filter is-invalid-id (numbers-in-range 0))] ⧗ Range → Number

sum-of-invalid-ids [sum (map sum-invalid-in-range 0)] ⧗ (List Range) → Number

main [sum-of-invalid-ids (parse-ranges 0)] ⧗ () → Number
